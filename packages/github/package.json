{
  "name": "@acr/github",
  "version": "0.0.1",
  "private": true,
  "description": "GitHub integration for AI Code Reviewer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
